<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="fit5120.monash.edu.features.searchingService.LocationMapper">

    <select id="getAllLocations" resultType="fit5120.monash.edu.entity.Location">
        SELECT
            *
        FROM location;
    </select>

    <select id="getAccessibilityOptionService" resultType="fit5120.monash.edu.features.searchingService.dto.model.AccessibilityOptionsModel">
        SELECT
            s.id,
            s.serviceName,
            s.placeName,
            s.rating,
            s.ratingNumber,
            s.weekdayDescription,
            l.latitude AS latitude,
            l.longitude as longitude,
            t.serviceType as serviceType
        FROM service s
        LEFT JOIN location l ON s.locationId = l.id
        LEFT JOIN serviceType t ON s.serviceTypeId = t.id
        <where>
            <if test="serviceType != null">
                AND t.serviceType = #{serviceType}
            </if>

            <if test="wheelchairPark != null and wheelchairPark == true" >
                AND s.wheelchairPark = #{wheelchairPark}
            </if>

            <if test="wheelchairEntrance != null and wheelchairEntrance == true">
                AND s.wheelchairEntrance = #{wheelchairEntrance}
            </if>

            <if test="wheelchairRestroom != null and wheelchairRestroom == true">
                AND s.wheelchairRestroom = #{wheelchairRestroom}
            </if>

            <if test="wheelchairSeating != null and wheelchairSeating == true">
                AND s.wheelchairSeating = #{wheelchairSeating}
            </if>
        </where>
    </select>


    <select id="getServiceDetailById">
        select
            S.*,
            l.address,
            l.suburb,
            l.state,
            l.postcode,
            l.latitude,
            l.longitude,
            t.serviceType
        FROM service s
        LEFT JOIN location l ON s.locationId = l.id
        LEFT JOIN serviceType t ON s.serviceTypeId = t.id
        where s.id = #{id};

    </select>

    <select id="getAllServices">
        select
            s.id,
            s.serviceName,
            s.placeName,
            s.contactNumber,
            s.website,
            s.wheelchairPark,
            s.wheelchairEntrance,
            s.wheelchairRestroom,
            s.wheelchairSeating,
            s.weekdayDescription,
            l.suburb,
            l.state,
            l.postcode,
            l.latitude,
            l.longitude,
            t.serviceType
        from service s
        LEFT JOIN location l on s.locationId = l.id
        LEFT JOIN serviceType t on s.serviceTypeid = t.id
        <where>
            <if test="serviceType != null">
                And t.serviceType = #{serviceType}
            </if>
        </where>
    </select>




    <select id="selectLocationById" resultType="fit5120.monash.edu.entity.Location">
        select *
        from location
        where id = #{id};
    </select>

