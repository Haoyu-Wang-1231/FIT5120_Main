    {
      "name": "places/ChIJLYRa2CNr1moRAWvnh1a8YT4/reviews/ChZDSUhNMG9nS0VJQ0FnSUNub3RXSkd3EAE",
      "relativePublishTimeDescription": "a year ago",
      "rating": 4,
      "text": {
        "text": "One of the better Chinese grocer South East of Melbourne.   Large variety of Asian products.  The place is roomy, clean, neat and no funny smell.  Most staff are friendly and wear a smile on their face.  Veggie and fruits are quite limited (there is a large fruit mart next door).  Overall, almost everything you need you will find here.",
        "languageCode": "en"
      },
      "originalText": {
        "text": "One of the better Chinese grocer South East of Melbourne.   Large variety of Asian products.  The place is roomy, clean, neat and no funny smell.  Most staff are friendly and wear a smile on their face.  Veggie and fruits are quite limited (there is a large fruit mart next door).  Overall, almost everything you need you will find here.",
        "languageCode": "en"
