    {
      "name": "places/ChIJLYRa2CNr1moRAWvnh1a8YT4/reviews/ChZDSUhNMG9nS0VJQ0FnTUNvMy1hTlJ3EAE",
      "relativePublishTimeDescription": "11 months ago",
      "rating": 5,
      "text": {
        "text": "Great selection of Asian products, the supermarket is quite large selling a variety of things from chips, ingredients, noodles, fruit and vegetable as well as bowels and plates and even sells Asian liqueur. Highly recommend visiting this location for any exotic ingredients you may be after!",
        "languageCode": "en"
      },
